rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // MASTER = sirf developer/owner ka Firebase Authentication (Email/Password) account.
    // Neeche email ko apne asli master email se badal kar Publish karein.
    function master() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'fatimatech96@gmail.com';
    }
    function closed(c, b, d) { return exists(/databases/$(database)/documents/clients/$(c)/dayEnds/$(b + '_' + d)); }
    function okOrder(o, id) {
      return o.uuid == id && o.bookerId is string && o.date is string
        && o.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && o.net is number;
    }

    // Har client ka data alag: clients/{CODE}/...  (CODE lamba aur andaza na lagne wala hota hai)
    // Client ki license (expiry / fees): app sirf apna document padh sakti hai (get), list nahi; likh sirf master sakta hai
    match /clients/{c} {
      allow get: if signedIn();
      allow list: if master();
      allow create, update: if master();
      allow delete: if false;

      // Orders: Day End ho chuki date par koi write nahi (booker ke liye)
      match /orders/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && okOrder(request.resource.data, id)
                      && !closed(c, request.resource.data.bookerId, request.resource.data.date);
        allow update: if signedIn() && okOrder(request.resource.data, id)
                      && request.resource.data.bookerId == resource.data.bookerId
                      && !closed(c, resource.data.bookerId, resource.data.date)
                      && !closed(c, request.resource.data.bookerId, request.resource.data.date);
        allow delete: if false;
      }

      // Cloud backups (Day End ka poora data): laptop sirf likh sakta hai, parh sirf master sakta hai
      match /backups/{id} {
        allow create: if signedIn();
        allow read: if master();
        allow update, delete: if false;
        match /parts/{part} {
          allow create, update: if signedIn();
          allow read: if master();
          allow delete: if false;
        }
      }

      // Day End: sirf ek baar likha ja sakta hai, phir kabhi badla ya mitaya nahi ja sakta
      match /dayEnds/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.bookerId is string && request.resource.data.date is string
                      && id == request.resource.data.bookerId + '_' + request.resource.data.date;
        allow update, delete: if false;
      }
    }

    // Master sab clients ke backups ek saath dekh sake (collection group query)
    match /{path=**}/backups/{id} {
      allow read: if master();
    }
  }
}
